{
  "mcpServers": {
    "mercury-market": {
      "command": "npx",
      "args": ["tsx", "src/mcp/server.ts"],
      "env": {
        "MERCURY_REFUND_LIMIT_USD": "${MERCURY_REFUND_LIMIT_USD:-150.00}",
        "MERCURY_ADVISOR_CONFIDENCE_THRESHOLD": "${MERCURY_ADVISOR_CONFIDENCE_THRESHOLD:-0.75}",
        "MERCURY_MAX_AGENT_STEPS": "${MERCURY_MAX_AGENT_STEPS:-12}",
        "MERCURY_MAX_RETRIES": "${MERCURY_MAX_RETRIES:-2}"
      }
    }
  }
}
