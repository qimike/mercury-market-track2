{
  "name": "mercury-market-resolution-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first customer resolution platform for Mercury Market (Track 1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:server": "tsx src/mcp/server.ts",
    "agent:cli": "tsx src/cli.ts",
    "eval": "tsx src/eval/runEval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
