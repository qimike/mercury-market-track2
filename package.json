{
  "name": "mercury-market-track2-governance",
  "version": "0.1.0",
  "private": true,
  "description": "Human-in-the-loop advisor and CI governance for Mercury Market (Track 2)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:server": "tsx src/mcp/server.ts",
    "advisor:cli": "tsx src/cli/index.ts",
    "governance:ci": "tsx src/governance/ciReview.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
