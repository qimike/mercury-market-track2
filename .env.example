# Copy to .env and fill in as needed. Never commit the real .env file.
# All synthetic/mock data — no production credentials belong here, ever.

# Optional. Only needed for `npm run advisor:cli -- submit ...` (live reasoning)
# and any test explicitly gated behind MERCURY_ENABLE_LIVE_API_TESTS=1. Every
# other command (demo-seed, approve, execute, audit, governance, npm test)
# runs with zero credentials against the in-memory mock backends.
ANTHROPIC_API_KEY=

# Model used by the advisor loop when talking to the real API.
MERCURY_MODEL=claude-sonnet-4-5

# Deployment environment tag (development | staging | production). Synthetic
# data is used regardless of this value in this repository.
MERCURY_ENV=development

# Path for a persistence adapter, if one is configured. The default in-memory
# adapters ignore this; kept for parity with a real deployment's config surface.
MERCURY_DB_PATH=:memory:

# --- Business thresholds (see src/domain/config.ts for defaults) ---
# Advisory risk threshold (decimal string, order currency): proposed refunds at
# or above this amount are flagged high-risk and require 2 independent human
# approvals (src/approvals/riskGate.ts) instead of 1. This never authorizes
# execution by itself — Track 2 has no autonomous execution path at any amount.
MERCURY_REFUND_LIMIT_USD=150.00

# Per-issue confidence (0-1) below which the precision-review pass flags an
# issue as low-confidence.
MERCURY_ADVISOR_CONFIDENCE_THRESHOLD=0.75

# Maximum agentic-loop steps before the advisor force-escalates.
MERCURY_MAX_AGENT_STEPS=12

# Maximum bounded retries for a transient/retryable tool error.
MERCURY_MAX_RETRIES=2

# Maximum bounded retries for structured-output schema/semantic validation failures.
MERCURY_MAX_OUTPUT_RETRIES=2

# Log verbosity for structured JSON logging (debug | info | warn | error).
MERCURY_LOG_LEVEL=info

# Set to "1" to allow tests tagged as live-API tests to run against the real
# Anthropic API. Leave unset (0) in CI / offline environments — this must be
# false for any CI run on an untrusted pull request.
MERCURY_ENABLE_LIVE_API_TESTS=0
