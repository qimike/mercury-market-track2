# Copy to .env and fill in as needed. Never commit the real .env file.

# Required only for LIVE Claude API calls (agent:cli, live tests). All unit/integration
# tests and the eval suite default to a deterministic fake model client and do NOT
# require this key.
ANTHROPIC_API_KEY=

# Model used by the coordinator/subagent loops when talking to the real API.
MERCURY_MODEL=claude-sonnet-4-5

# --- Business thresholds (see src/domain/config.ts for defaults) ---
# Refunds at or below this amount (in the order's currency, decimal string) may be
# processed autonomously when identity is verified and policy confidence is high.
MERCURY_AUTONOMOUS_REFUND_LIMIT=150.00

# Refunds at or above this amount always require human escalation regardless of
# confidence.
MERCURY_MANDATORY_ESCALATION_LIMIT=500.00

# Maximum agentic-loop iterations before the coordinator force-escalates.
MERCURY_MAX_LOOP_ITERATIONS=12

# Maximum bounded retries for a transient/retryable tool error.
MERCURY_MAX_TOOL_RETRIES=2

# Maximum bounded retries for structured-output schema/semantic validation failures.
MERCURY_MAX_OUTPUT_RETRIES=2

# Set to "1" to allow tests tagged as live-API tests to run against the real
# Anthropic API. Leave unset in CI / offline environments.
MERCURY_ENABLE_LIVE_API_TESTS=0
